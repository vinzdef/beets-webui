# Python
__pycache__/
*.py[cod]
.venv/
dist/
.pytest_cache/
.ruff_cache/

# Frontend
frontend/node_modules/
frontend/.svelte-kit/
src/beetsplug/webui/static/

# Example environments: keep the configs and folder placeholders, nothing else
/examples/docker/config/*
!/examples/docker/config/config.yaml
/examples/docker/inbox/*
!/examples/docker/inbox/.gitkeep
/examples/docker/music/*
!/examples/docker/music/.gitkeep
/examples/local/*
!/examples/local/config.yaml
!/examples/local/inbox/
/examples/local/inbox/*
!/examples/local/inbox/.gitkeep
!/examples/local/music/
/examples/local/music/*
!/examples/local/music/.gitkeep

# Never commit beets libraries, their state, or music, wherever they end up
*.db
*.db-journal
*.db-*.bak
*.bak
state.pickle
import.log
*.mp3
*.flac
*.m4a
*.aac
*.alac
*.ogg
*.opus
*.wav
*.aif
*.aiff
*.ape
*.wv
*.wma
*.mpc
*.dsf
*.dff
*.cue
